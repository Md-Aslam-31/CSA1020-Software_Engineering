  <description>ReleaseHarbor — a real pipeline loaded from Git. Tests must pass before the Docker image is published and deployed to the separate free Render demo service. Commits are detected by SCM polling after the first run. Jenkins remains local to this computer.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <hudson.triggers.SCMTrigger>
